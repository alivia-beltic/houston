# Beltic BFF — Edge Function secrets.
#
# Copy to `.env` for local `supabase functions serve`, and set the same keys in
# the hosted project with `supabase secrets set` (see BELTIC_BFF_SETUP.md).
# NEVER commit a populated `.env` — only this example belongs in git.
#
# Consumed by supabase/functions/_shared/beltic.ts (loadBelticConfig).

# Org-scoped Beltic X-Api-Key. Secret — never exposed to the client; the proxy
# injects it server-side on every call to Beltic.
BELTIC_API_KEY=blt_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the Beltic API (no trailing slash).
BELTIC_API_URL=https://api.beltic.com

# The Beltic org slug this Houston deployment is bound to (one org per deploy).
BELTIC_ORG=your-org-slug

# NOTE: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# the Supabase platform at runtime — do NOT set them here. The audit poller uses
# the service-role key to bypass RLS when writing user_credentials, and to
# authenticate the cron trigger.
